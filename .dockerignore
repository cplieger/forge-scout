# The image needs only these build inputs: deny everything, then allow them
# back in, so .git, tests, docs and local scratch never reach the builder.
*
!go.mod
!go.sum
!*.go
!internal/
!LICENSE
!NOTICE
!THIRD_PARTY_NOTICES.md
!scripts/collect-licenses.sh
# go build never compiles tests, so a test edit leaves the build layers cached.
**/*_test.go
**/testdata/
